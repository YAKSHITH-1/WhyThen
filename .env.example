# Application Settings
WHYTHEN_DATA_DIR=data
WHYTHEN_SQLITE_PATH=data/sqlite/whythen.db
WHYTHEN_CHROMA_DIR=data/chroma

# Embedding Model
WHYTHEN_EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM Configuration
# Options: ollama, openai, mock
WHYTHEN_LLM_PROVIDER=ollama
WHYTHEN_LLM_MODEL=llama3.2
WHYTHEN_OLLAMA_BASE_URL=http://localhost:11434
WHYTHEN_OPENAI_API_KEY=
WHYTHEN_OPENAI_BASE_URL=

